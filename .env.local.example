#   email TEXT UNIQUE NOT NULL,
#   created_at TIMESTAMPTZ DEFAULT NOW()
# );
#
# -- 認定プロ事前登録（認定フロー・C 領域 ティア制度に対応）
# CREATE TABLE pros (
#   id BIGSERIAL PRIMARY KEY,
