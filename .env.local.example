#   training_session_id BIGINT,         -- training_sessions(id) を参照（割当済みの講習回）
#   training_passed_at TIMESTAMPTZ,     -- 修了テスト合格日時
#   certified_at TIMESTAMPTZ,           -- 認定発行日時
#   certification_number TEXT UNIQUE,   -- 認定番号（QR バッジ表示用）
