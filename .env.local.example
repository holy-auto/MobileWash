# Site
NEXT_PUBLIC_SITE_URL=https://mobilewash.jp

# App store URLs (leave empty to render "COMING SOON" buttons)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 任意: 集計用にサービスロールキーも設定するとRLSをバイパスして
# count を取得できます（src/lib/stats.ts が利用）。
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase SQL — テーブル作成
# 詳細な運用ポリシーは docs/pro-operations.md を参照
#
# -- 一般ユーザー事前登録（メールアドレスのみ）
# CREATE TABLE waitlist (
